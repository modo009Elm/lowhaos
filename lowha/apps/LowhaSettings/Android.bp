android_app {
    name: "LowhaSettings",

    srcs: ["src/**/*.kt"],
    resource_dirs: ["res"],

    certificate: "platform",

    // MUST be system_ext, not system/priv-app.
    //
    // A privileged app and its privapp-permissions allowlist have to live on
    // the SAME partition. Installing this to /system/priv-app while its
    // allowlist sat on system_ext caused the framework to abort during
    // SystemServer startup -- a boot loop, not a warning. It is not privileged
    // now, but the placement is pinned so the pairing can never drift again.
    system_ext_specific: true,

    static_libs: [
        "androidx.appcompat_appcompat",
        "androidx.recyclerview_recyclerview",
        "com.google.android.material_material",
    ],

    optimize: {
        enabled: false,
    },
}
